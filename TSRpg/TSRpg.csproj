<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TSRpg</AssemblyName>
    <RootNamespace>TSRpg</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Title>TSRpg</Title>
    <Authors>matheus-fsc</Authors>
    <Description>Lightweight RPG classes, XP and levels for TShock servers, with tougher bosses.</Description>
    <Product>TSRpg</Product>
    <PackageProjectUrl>https://github.com/matheus-fsc/TS_Rpg</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/matheus-fsc/TS_Rpg</RepositoryUrl>
    <PackageTags>Tshock, Terraria, Plugin, RPG</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the TShock server at runtime: never copy them next to the plugin. -->
    <PackageReference Include="TShock" Version="6.2.1" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
